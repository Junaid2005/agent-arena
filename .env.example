# Frontend: place in apps/web/.env.local
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Optional visual venue GLB; manual authoritative colliders remain in shared/constants.ts.
# NEXT_PUBLIC_VENUE_URL=https://assets.example.com/venue.glb
NEXT_PUBLIC_VENUE_SCALE=1
NEXT_PUBLIC_VENUE_ROTATION=0

# Vercel production: leave NEXT_PUBLIC_SERVER_URL unset. Server-only Upstash TLS URL:
# REDIS_URL=rediss://default:password@your-upstash-host:6379
# Optional isolated development/test namespace:
# GHOST_STATE_PREFIX=ghost-arena:local

# Standalone local game server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Reserved for the pending avatar pipeline. Keep all of these server-only.
# MESHY_API_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ASSET_PUBLIC_URL=

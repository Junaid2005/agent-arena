# Frontend: place in apps/web/.env.local
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Optional visual venue GLB; manual authoritative colliders remain in shared/constants.ts.
# NEXT_PUBLIC_VENUE_URL=https://assets.example.com/venue.glb
NEXT_PUBLIC_VENUE_SCALE=1
NEXT_PUBLIC_VENUE_ROTATION=0

# Persistent game server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Live commentary (server-only). Leave the key empty to disable it.
# COMMENTARY_ENABLED=true
# DEEPGRAM_API_KEY=
# COMMENTARY_THINK_MODEL=gpt-4.1-mini
# COMMENTARY_VOICE=aura-2-atlas-en
# COMMENTARY_SPEED=1.1
# COMMENTARY_TEMPERATURE=1.0
# COMMENTARY_IDLE_MS=45000
# COMMENTARY_SESSION_MS=1200000

# Reserved for the pending avatar pipeline. Keep all of these server-only.
# MESHY_API_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ASSET_PUBLIC_URL=

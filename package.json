{
  "name": "ghost-arena",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ghost/web",
    "build": "npm run build -w @ghost/web",
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "test": "tsx --test apps/server/src/*.test.ts",
    "test:network": "tsx scripts/network-test.ts",
    "dev:paintball": "concurrently -n WEB,SERVER -c cyan,magenta \"npm run dev -w @ghost/web\" \"npm run dev -w @ghost/server\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "scheduler": "0.27.0",
    "source-map-js": "1.2.2"
  },
  "type": "module",
  "dependencies": {
    "next": "16.4.3"
  }
}
